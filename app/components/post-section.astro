---
import type { HTMLAttributes } from 'astro/types'
import PostCard from './post-card.astro'

interface Props extends HTMLAttributes<'section'> {
  totalPosts: number
  posts: Array<{
    title: string
    description: string
    image?: string
    slug: string
  }>
}

const foo = 'foo'
const { totalPosts, posts, class: className } = Astro.props
---

<style>
  .heading {
    font-size: var(--size-lg);
    line-height: var(--line-height-lg);
    font-weight: 700;

    margin-bottom: var(--spacing-base);
  }
  @media (width >= 40rem) {
    .heading {
      font-size: var(--size-2xl);
      line-height: var(--line-height-2xl);
    }
  }

  .supporting {
    display: block;
    color: var(--sand-11);
    font-size: var(--size-base);
    line-height: var(--line-height-base);
  }
</style>
<section class={className}>
  <span class='supporting'>{`${totalPosts}件の投稿`}</span>
  <h2 class='heading'>ポスト</h2>
  <ul>
    {
      posts.map(({ title, description, image, slug }) => (
        <li>
          <PostCard
            title={title}
            description={description}
            url={`/contents/${slug}`}
            imageSrc={image}
          />
        </li>
      ))
    }
  </ul>
</section>
