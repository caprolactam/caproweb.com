---
import SiteLogo from '#app/components/brand-icons/my-site.svg'
import { ToggleColorMode } from '#app/components/color-mode/color-mode.tsx'

const ICON_SIZE = 24
---

<header>
  <a href='/' class='site-link'>
    <SiteLogo width={ICON_SIZE} height={ICON_SIZE} />
    caproweb
  </a>
  <ToggleColorMode client:load />
</header>
<style>
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .site-link {
    display: inline-flex;
    align-items: center;
    text-transform: uppercase;
    gap: 8px;
    height: 48px;
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    font-weight: 350;
    line-height: 1;
    text-decoration: none;
    color: var(--color-text);
  }
</style>
