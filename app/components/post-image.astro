---
import { Image } from 'astro:assets'

type Props = {
  src: string
  width: number
  height: number
  format: 'png' | 'jpg' | 'jpeg' | 'tiff' | 'webp' | 'gif' | 'svg' | 'avif'
  alt: string
}

const { alt, ...props } = Astro.props

const isSvg = props.format === 'svg'

let svgComponent: any = null
if (isSvg) {
  svgComponent = (await import(/* @vite-ignore */ `${props.src}&raw`)).default
}
---

{
  svgComponent ? (
    <Fragment set:html={svgComponent} />
  ) : (
    <Image src={props} alt={alt} />
  )
}
