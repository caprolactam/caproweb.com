---
import Github from './brand-icons/github.svg'
import X from './brand-icons/x.svg'
import VisuallyHidden from './visually-hidden.astro'

const currentYear = new Date().getFullYear()
---

<style>
  footer {
    border-top: 1px solid var(--sand-6);
    display: flex;
    min-height: 56px;
    align-items: center;
    gap: 8px;
  }

  .author {
    margin-right: auto;
    font-size: var(--text-sm);
    line-height: var(--line-height-sm);
  }

  .sns-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    width: 36px;
    height: 36px;
    &:hover {
      background-color: var(--sand-4);
    }
    &:focus-visible {
      background-color: var(--sand-5);
    }
  }

  .sns-link :global(svg path) {
    fill: black;

    html.dark & {
      fill: white;
    }
  }
</style>
<footer>
  <span class='author'>{`© ${currentYear} caprolactam`}</span>
  <a href='https://github.com/caprolactam' class='sns-link'>
    <VisuallyHidden>著者のGitHubアカウント</VisuallyHidden>
    <Github width={24} height={24} />
  </a>
  <a href='https://x.com/derivesfrom' class='sns-link'>
    <VisuallyHidden>著者のXアカウント</VisuallyHidden>
    <X width={18} height={18} />
  </a>
</footer>
