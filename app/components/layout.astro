---
import BreadCrumbs from "#app/components/breadcrumbs.astro";
import type { Props as BreadCrumbsProps } from "#app/components/breadcrumbs.astro";
import Footer from "#app/components/footer.astro";
import ThemeScript from "#app/components/color-mode/script.astro";
import Header from "./header.astro";

import "#app/styles/tailwind.css";

interface Props {
  breadCrumbs?: BreadCrumbsProps["links"];
}

const { breadCrumbs } = Astro.props;
---

<style>
  .no-shrink {
    flex: 0 0 auto;
  }

  .max-width-wrapper {
    width: 100%;
    max-width: 64rem;
    margin-inline: auto;
    padding-inline: var(--layout-margin);
  }

  main {
    flex: 1 1 0%;
    min-width: 0px;
    margin-block: 32px;
  }

  @media (width >= 48rem) {
    main {
      margin-top: 48px;
      margin-bottom: 144px;
    }
  }
</style>

<html lang="ja" class="bg-brand-1 text-brand-12 antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <link rel="apple-touch-icon" href="/favicons/apple-touch-icon.png" />
    <link
      rel="icon"
      type="image/svg+xml"
      sizes="any"
      href="/favicons/favicon.svg"
    />
    <link rel="manifest" href="/manifest.json" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <ThemeScript />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="max-width-wrapper">
      <slot />
    </main>
    {
      breadCrumbs && (
        <div class="max-width-wrapper no-shrink">
          <BreadCrumbs links={breadCrumbs} />
        </div>
      )
    }
    <div class="max-width-wrapper no-shrink">
      <Footer />
    </div>
  </body>
</html>
