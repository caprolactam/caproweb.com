---
import Breadcrumb from './breadcrumb.astro'
import type { Props as BreadcrumbProps } from './breadcrumb.astro'
import ThemeScript from './color-mode/script.astro'
import Footer from './footer.astro'
import Header from './header.astro'

import '#app/styles/app.css'

interface Props {
  breadcrumb?: BreadcrumbProps['links']
}

const { breadcrumb } = Astro.props
---

<style>
  #root {
    --max-content-inline-size: 64rem;
    display: grid;
    grid-template-areas:
      'header header header'
      '. content .'
      '. breadcrumb .'
      '. footer .';
    grid-template-columns:
      1fr
      min(
        calc(100% - var(--layout-margin-inline) * 2),
        var(--max-content-inline-size)
      )
      1fr;
    grid-template-rows: auto 1fr auto auto;
    min-height: 100dvh;
  }

  .header-wrapper {
    grid-area: header;
    display: grid;
    grid-template-columns: subgrid;
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: var(--color-app-background);
    /** TODO: background imageを追加 */
  }

  .centering-header {
    height: 80px;
    display: flex;
    align-items: center;
    /* width: 100%; */
  }

  .sticky {
    grid-column: 2 / -2;
  }

  main {
    margin-block: 32px;
  }

  @media (--tablet-and-up) {
    main {
      margin-top: 48px;
      margin-bottom: 144px;
    }
  }
</style>
<html lang='ja'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <meta name='referrer' content='no-referrer' />
    <link
      rel='preload'
      as='font'
      href='/fonts/cascadia-mono-latin-roman-variable.woff2'
      crossorigin='anonymous'
    />
    <link rel='apple-touch-icon' href='/favicons/apple-touch-icon.png' />
    <link
      rel='icon'
      type='image/svg+xml'
      sizes='any'
      href='/favicons/favicon.svg'
    />
    <link rel='manifest' href='/manifest.json' />
    <link rel='sitemap' href='/sitemap-index.xml' />
    <slot name='head' />
    <ThemeScript />
    <meta name='generator' content={Astro.generator} />
  </head>
  <body>
    <div id='root'>
      <div class='header-wrapper'>
        <div class='sticky'>
          <div class='centering-header'>
            <Header />
          </div>
        </div>
      </div>
      <main style={{ gridArea: 'content' }}>
        <slot />
      </main>
      {
        breadcrumb && (
          <div style={{ gridArea: 'breadcrumb' }}>
            <Breadcrumb links={breadcrumb} />
          </div>
        )
      }
      <div style={{ gridArea: 'footer' }}>
        <Footer />
      </div>
    </div>
  </body>
</html>
