---
import { Image } from 'astro:assets'

type Props = {
  cover: {
    src: string
    width: number
    height: number
    format: 'png' | 'jpg' | 'jpeg' | 'tiff' | 'webp' | 'gif' | 'svg' | 'avif'
  }
  alt: string
}

const { alt, cover } = Astro.props

// svg形式の場合、content layerはcoverフィールドをそのままレンダリング可能な
// Astroコンポーネントとして解決するので、それを描画してsvgをインライン展開する
const isSvgComponent = typeof cover === 'function'
const SvgIcon = cover as unknown as (props: Record<string, unknown>) => unknown
---

{
  isSvgComponent ? (
    <SvgIcon role='img' aria-label={alt} />
  ) : (
    <Image src={cover} alt={alt} />
  )
}
