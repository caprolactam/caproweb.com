---
import { getCollection, render } from 'astro:content'
import Layout from '#app/components/layout.astro'
import Title from '#app/components/title.astro'
import { getSlug } from '#app/lib/frontmatter.ts'

export async function getStaticPaths() {
  const allContents = await getCollection('posts', ({ data }) => {
    return import.meta.env.PROD ? data.isDraft !== true : true
  })

  const sortedByPublishedAt = allContents.sort((former, latter) => {
    return (
      new Date(latter.data.publishedAt).getTime() -
      new Date(former.data.publishedAt).getTime()
    )
  })

  return sortedByPublishedAt.map((content) => ({
    params: { slug: getSlug(content.filePath ?? content.id) },
    props: { entry: content },
  }))
}

const { slug } = Astro.params
const { entry } = Astro.props

const { Content } = await render(entry)
---

<Layout
  breadCrumbs={[
    { label: 'ホーム', href: '/' },
    { label: entry.data.title, href: `/contents/${slug}` },
  ]}
>
  <Fragment slot='head'>
    <title>{`${entry.data.title} | Capro Web`}</title>
    <meta name='description' content={entry.data.description} />
  </Fragment>
  <div class='prose'>
    <a href='/' class='mb-[1.25em] inline-flex'> ← ホームに戻る </a>
    <article>
      <Title
        title={entry.data.title}
        publishedAt={entry.data.publishedAt}
        updatedAt={entry.data.updatedAt}
        imageSrc={entry.data.image}
      />
      <Content />
    </article>
  </div>
</Layout>
