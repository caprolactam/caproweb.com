---
import { getCollection } from 'astro:content'
import Layout from '#app/components/layout.astro'
import { PostList } from '#app/components/post-list/index.ts'
import { Section } from '#app/components/section.tsx'
import { SidebarLayout } from '#app/components/sidebar-layout.tsx'
import { TagList } from '#app/components/tag-list.tsx'

const allPosts = (
  await getCollection('posts', ({ data }) => {
    return import.meta.env.PROD ? data.isDraft !== true : true
  })
)
  .map((post) => ({ ...post.data, slug: post.id }))
  .sort((a, b) => b.publishedAt.getTime() - a.publishedAt.getTime())

const allTags = [...new Set(allPosts.flatMap((post) => post.tags))]
---

<Layout breadcrumb={[{ label: 'ホーム', href: '/' }]}>
  <Fragment slot='head'>
    <title>ホーム | Capro Web</title>
    <meta name='description' content='Web開発に関する反省' />
  </Fragment>
  <SidebarLayout.Container
    baseSidebarWidth='300px'
    gap='var(--layout-margin-inline)'
  >
    <SidebarLayout.Content>
      <Section.Root>
        <Section.Heading>すべての記事</Section.Heading>
        <PostList.Root>
          {
            allPosts.map(({ title, description, image, slug }) => (
              <PostList.Item
                title={title}
                description={description}
                url={`/contents/${slug}`}
                cover={image}
                coverAlt={title}
              />
            ))
          }
        </PostList.Root>
      </Section.Root>
    </SidebarLayout.Content>
    <SidebarLayout.Sidebar>
      <Section.Root>
        <Section.Heading>タグから探す</Section.Heading>
        <TagList.Root>
          {
            allTags.map((tag) => (
              <TagList.Item label={tag} href={`/tags/${tag}`} />
            ))
          }
        </TagList.Root>
      </Section.Root>
    </SidebarLayout.Sidebar>
  </SidebarLayout.Container>
</Layout>
