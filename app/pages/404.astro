---
import Layout from '#app/components/layout.astro'
---

<style>
  .not-found {
    display: flex;
    justify-content: center;
    align-items: center;
    height: min(600px, 100%);
    color: var(--color-text);
    font-size: var(--text-lg);
    line-height: var(--line-height-lg);
  }
</style>
<Layout
  breadcrumb={[
    { label: 'ホーム', href: '/' },
    { label: '存在しないページ', href: '/' },
  ]}
>
  <Fragment slot='head'>
    <title>存在しないページ | Capro Web</title>
    <meta name='description' content='お探しのページは見つかりませんでした' />
    <meta name='robots' content='noindex' />
  </Fragment>
  <div class='not-found'>お探しのページは見つかりませんでした</div>
</Layout>
